[Unit]
Description=Isolated ForexTestLab Pine test

[Service]
Type=exec
DynamicUser=yes
WorkingDirectory=/opt/forextestlab-pine
ExecStart=/usr/bin/node --max-old-space-size=256 --import /opt/forextestlab-pine/node_modules/@nullarch/resin/register.mjs /opt/forextestlab-pine/worker.mjs
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=NODE_ENV=production
RuntimeMaxSec=35
MemoryMax=384M
CPUQuota=100%
TasksMax=32
LimitNOFILE=64
NoNewPrivileges=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
