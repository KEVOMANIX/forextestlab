// ForexTestLab data model.
//
// Prices are stored as STRINGS and all financial math is done with decimal.js
// in application code — never with SQL/JS floating point. This keeps the schema
// portable: to move to production PostgreSQL, change `provider` to "postgresql"
// and point DATABASE_URL at your Postgres instance (see README). No column type
// changes are required.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for migrations / db push.
  directUrl = env("DIRECT_URL")
}

model MarketInstrument {
  id             String            @id @default(cuid())
  symbol         String            @unique // e.g. "EURUSD"
  displayName    String // e.g. "EUR/USD"
  baseCurrency   String
  quoteCurrency  String
  pipSize        String // decimal string, e.g. "0.0001"
  pricePrecision Int
  enabled        Boolean           @default(true)
  createdAt      DateTime          @default(now())
  candles        MarketCandle[]
  imports        DataImport[]
  sessions       BacktestSession[]
}

/// Application profile keyed by the Supabase Auth user UUID.
/// Authentication credentials remain in Supabase Auth; this table stores only
/// ForexTestLab-owned profile data and relations.
model UserProfile {
  id                     String                @id
  email                  String                @unique
  displayName            String?
  billingPlan            String                @default("free")
  billingStatus          String                @default("inactive")
  proAccessUntil         DateTime?
  /// Legacy audit marker from the original account-level Free allowance.
  /// New trial enforcement uses TrialDevice.
  freeSessionUsedAt      DateTime?
  paystackCustomerCode   String?               @unique
  paddleCustomerId       String?               @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  workspaceJson          String?
  workspaceTemplatesJson String?
  sessions               BacktestSession[]
  billingPayments        BillingPayment[]
  billingSubscriptions   BillingSubscription[]

  @@index([createdAt])
}

/// Contact-form enquiries retained for support follow-up in the admin console.
model ContactMessage {
  id             String   @id @default(cuid())
  name           String
  email          String
  subject        String
  message        String
  consent        Boolean  @default(true)
  status         String   @default("open")
  deliveryStatus String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

/// Durable waitlist signup. Pairs are stored as JSON so the form can evolve
/// without a join table for a small, append-mostly marketing dataset.
model WaitlistEntry {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  experience     String
  pairsJson      String
  consent        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

model SupportConversation {
  id                         String                   @id @default(cuid())
  userId                     String?
  visitorId                  String?
  accessTokenHash            String?
  customerName               String?
  customerEmail              String?
  subject                    String                   @default("Support request")
  category                   String                   @default("other")
  priority                   String                   @default("normal")
  channel                    String                   @default("widget")
  status                     String                   @default("open")
  assignedAgent              SupportAgent?            @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedAgentId            String?
  assignedAgentName          String?
  linkedSessionId            String?
  contextJson                String?
  customerUnreadCount        Int                      @default(0)
  agentUnreadCount           Int                      @default(1)
  customerLastReadAt         DateTime?
  agentLastReadAt            DateTime?
  firstResponseAt            DateTime?
  lastMessageAt              DateTime                 @default(now())
  snoozedUntil               DateTime?
  resolvedAt                 DateTime?
  closedAt                   DateTime?
  satisfactionScore          Int?
  satisfactionComment        String?
  satisfactionAt             DateTime?
  lastCustomerNotificationAt DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  messages                   SupportMessage[]
  tags                       SupportConversationTag[]

  @@index([status, updatedAt])
  @@index([assignedAgentId, status, updatedAt])
  @@index([priority, status, updatedAt])
  @@index([visitorId, updatedAt])
  @@index([userId, updatedAt])
  @@index([lastMessageAt])
}

model SupportMessage {
  id              String              @id @default(cuid())
  conversation    SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  String
  clientMessageId String?             @unique
  senderType      String
  senderId        String?
  senderName      String
  kind            String              @default("text")
  visibility      String              @default("customer")
  body            String
  metadataJson    String?
  deliveredAt     DateTime?
  readAt          DateTime?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  attachments     SupportAttachment[]

  @@index([conversationId, createdAt])
  @@index([conversationId, visibility, createdAt])
}

model SupportAgent {
  id                    String                @id @default(cuid())
  userId                String                @unique
  email                 String                @unique
  displayName           String
  role                  String                @default("agent")
  active                Boolean               @default(true)
  lastSeenAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  assignedConversations SupportConversation[]

  @@index([active, displayName])
}

model SupportAttachment {
  id        String         @id @default(cuid())
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime       @default(now())

  @@index([messageId, createdAt])
}

model SupportTag {
  id            String                   @id @default(cuid())
  name          String                   @unique
  color         String                   @default("#22c3a0")
  createdAt     DateTime                 @default(now())
  conversations SupportConversationTag[]
}

model SupportConversationTag {
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  tag            SupportTag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId          String
  createdAt      DateTime            @default(now())

  @@id([conversationId, tagId])
  @@index([tagId, createdAt])
}

model SupportSavedReply {
  id        String   @id @default(cuid())
  title     String   @unique
  body      String
  category  String?
  active    Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, title])
}

/// Immutable record of privileged actions performed through the admin console.
model AdminAuditEvent {
  id           String   @id @default(cuid())
  actorUserId  String
  actorEmail   String
  action       String
  targetType   String
  targetId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

/// Bounded operational history written by the Lightsail monitor. Detailed
/// provider responses stay out of the public API; admins only see status and a
/// short diagnostic message.
model OperationalCheck {
  id         String   @id @default(cuid())
  component  String
  status     String
  latencyMs  Int?
  message    String?
  metadataJson String?
  checkedAt  DateTime @default(now())

  @@index([component, checkedAt])
  @@index([status, checkedAt])
}

/// First-party, low-cardinality product telemetry. It deliberately excludes IP
/// addresses, user agents and arbitrary page contents.
model ProductEvent {
  id           String   @id @default(cuid())
  name         String
  userId       String?
  anonymousId  String?
  path         String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([anonymousId, createdAt])
  @@index([createdAt])
}

/// Short, voluntary feedback captured after a user completes a replay.
model ProductFeedback {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
}

model BillingPayment {
  id                    String      @id @default(cuid())
  user                  UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  reference             String      @unique
  providerTransactionId String?
  productKey            String
  amount                Int
  currency              String
  provider              String      @default("paystack")
  status                String      @default("initialized")
  channel               String?
  paidAt                DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status, createdAt])
}

model BillingSubscription {
  id                String      @id @default(cuid())
  user              UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  subscriptionCode  String      @unique
  planCode          String
  productKey        String
  provider          String      @default("paystack")
  status            String
  nextPaymentAt     DateTime?
  cancelAtPeriodEnd Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId, status])
  @@index([provider, status])
}

model BillingWebhookEvent {
  id          String   @id
  eventType   String
  provider    String   @default("paystack")
  processedAt DateTime @default(now())

  @@index([eventType, processedAt])
}

/// Holds Paddle ownership data for checkouts completed before an account is
/// created. The matching email claims the subscription on first sign-in.
model PaddleCustomerClaim {
  customerId        String    @id
  email             String?   @unique
  subscriptionId    String?   @unique
  priceId           String?
  productKey        String?
  status            String?
  nextPaymentAt     DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([email, status])
}

/// Durable browser-device allowance for the three-session product trial.
/// The id is a one-way SHA-256 hash of an opaque, HttpOnly device cookie.
model TrialDevice {
  id           String            @id
  sessionsUsed Int               @default(0)
  createdAt    DateTime          @default(now())
  lastUsedAt   DateTime          @default(now())
  sessions     BacktestSession[]

  @@index([lastUsedAt])
}

model MarketCandle {
  id           String           @id @default(cuid())
  instrument   MarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  instrumentId String
  timeframe    String // Timeframe union value, e.g. "5m"
  timestamp    BigInt // UTC epoch milliseconds at candle open
  open         String
  high         String
  low          String
  close        String
  volume       String?
  bidOpen      String?
  bidHigh      String?
  bidLow       String?
  bidClose     String?
  askOpen      String?
  askHigh      String?
  askLow       String?
  askClose     String?
  source       String
  createdAt    DateTime         @default(now())

  @@unique([instrumentId, timeframe, timestamp])
  @@index([instrumentId, timeframe, timestamp])
  @@index([timeframe, timestamp])
}

model DataImport {
  id           String            @id @default(cuid())
  instrument   MarketInstrument? @relation(fields: [instrumentId], references: [id])
  instrumentId String?
  symbol       String
  timeframe    String
  source       String
  fileName     String?
  rowsRead     Int               @default(0)
  rowsImported Int               @default(0)
  rowsRejected Int               @default(0)
  gapsDetected Int               @default(0)
  report       String? // JSON string with details
  status       String            @default("completed")
  createdAt    DateTime          @default(now())
}

model BacktestSession {
  id                 String            @id @default(cuid())
  /// Opaque token used to authorise an anonymous demonstration session.
  token              String            @unique
  user               UserProfile?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String?
  trialDevice        TrialDevice?      @relation(fields: [trialDeviceId], references: [id], onDelete: SetNull)
  trialDeviceId      String?
  anonymous          Boolean           @default(true)
  anonymousExpiresAt DateTime?
  instrument         MarketInstrument  @relation(fields: [instrumentId], references: [id])
  instrumentId       String
  symbol             String
  timeframe          String
  startTime          BigInt
  endTime            BigInt
  status             String            @default("idle")
  speed              Float             @default(1)
  visibleIndex       Int               @default(-1)
  totalCandles       Int               @default(0)
  lockedBeforeIndex  Int               @default(0)
  startingBalance    String
  balance            String
  equity             String
  maxEquity          String
  maxDrawdown        String            @default("0")
  maxDrawdownPercent String            @default("0")
  accountCurrency    String            @default("USD")
  spreadPips         String
  commissionPerLot   String
  slippagePips       String
  executionPolicy    String            @default("conservative")
  dataSource         String
  demoData           Boolean           @default(false)
  notes              String?
  /// Serialised engine SessionState — the authoritative source for stepping.
  /// Relational trade/equity rows below are queryable projections of it.
    stateJson          String            @default("{}")
    /// Private R2 key for a compressed large snapshot. When set, stateJson
    /// retains only compact config metadata for list and dashboard queries.
    stateObjectKey     String?
    /// Uncompressed snapshot size for monitoring and migration decisions.
    stateSizeBytes     Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  orders             SimulatedOrder[]
  trades             SimulatedTrade[]
  equitySnapshots    EquitySnapshot[]
  parentSessionId    String?
  parentSession      BacktestSession?  @relation("SessionBranches", fields: [parentSessionId], references: [id], onDelete: SetNull)
  branches           BacktestSession[] @relation("SessionBranches")
  branchPointIndex   Int?
  branchPointTime    BigInt?
  branchRootId       String?

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([trialDeviceId, createdAt])
  @@index([anonymous, anonymousExpiresAt])
  @@index([parentSessionId])
  @@index([branchRootId])
}

model SimulatedOrder {
  id                  String          @id @default(cuid())
  session             BacktestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId           String
  direction           String
  sizingMode          String
  lots                String
  requestedStopLoss   String?
  requestedTakeProfit String?
  createdIndex        Int
  createdTime         BigInt
  createdAt           DateTime        @default(now())
}

model SimulatedTrade {
  id                String          @id @default(cuid())
  session           BacktestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId         String
  direction         String
  entryPrice        String
  exitPrice         String
  entryTime         BigInt
  exitTime          BigInt
  entryIndex        Int
  exitIndex         Int
  lots              String
  stopLoss          String?
  takeProfit        String?
  commission        String
  pnl               String
  pips              String
  exitReason        String
  intrabarAmbiguous Boolean         @default(false)
  notes             String?
  createdAt         DateTime        @default(now())

  @@index([sessionId])
}

/// One economic calendar release — a single publication of a single indicator.
///
/// Numbers are decimal STRINGS like every other figure in this schema. They are
/// not money, but they are compared and formatted, and a float would round
/// 54.5 to 54.499999.
///
/// `actual` is null for a release that has not happened yet, which is exactly
/// how a replay wants it: an event ahead of the playhead shows a forecast and no
/// actual, matching what the trader could have known.
model EconomicEvent {
  id     String @id @default(cuid())
  /// "mt5" — which export this row came from, so a second provider can be added
  /// alongside rather than overwriting.
  source String @default("mt5")
  /// The provider's own id for this release. Unique with `source`, so re-running
  /// an export updates rows in place instead of duplicating them.
  externalId String
  /// The provider's id for the recurring indicator, e.g. every CPI release
  /// shares one. Lets the chart group an event with its own history.
  seriesId   String?
  eventCode  String?
  name       String
  currency   String
  country    String?
  /// "none" | "low" | "medium" | "high"
  importance String
  /// UTC epoch milliseconds of the release.
  timestamp  BigInt
  /// "exact" | "date" | "notime" | "tentative". Anything but "exact" has no
  /// dependable clock time, so the chart must not mark a precise minute.
  timeMode   String  @default("exact")
  /// Start of the period the figure describes, UTC epoch ms. "CPI for July".
  period     BigInt?
  actual     String?
  forecast   String?
  previous   String?
  revisedPrevious String?
  /// "percent" | "currency" | "people" | … for formatting; null when unitless.
  unit       String?
  /// "thousands" | "millions" | "billions" | "trillions", or null.
  multiplier String?
  digits     Int      @default(0)
  revision   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([source, externalId])
  @@index([timestamp])
  @@index([currency, timestamp])
  @@index([importance, timestamp])
}

model EquitySnapshot {
  id        String          @id @default(cuid())
  session   BacktestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  index     Int
  time      BigInt
  balance   String
  equity    String

  @@index([sessionId, index])
}
