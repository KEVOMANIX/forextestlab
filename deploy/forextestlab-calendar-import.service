[Unit]
Description=Import a new ForexTestLab MT5 economic-calendar export
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/forextestlab
EnvironmentFile=/home/ubuntu/forextestlab/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run calendar:sync -- --file data/forextestlab-calendar.csv
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/forextestlab/data

