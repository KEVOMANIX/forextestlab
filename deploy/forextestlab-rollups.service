[Unit]
Description=Rebuild ForexTestLab hourly and New York daily chart rollups in R2
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/forextestlab
EnvironmentFile=/home/ubuntu/forextestlab/.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--conditions=react-server
# Incremental: the last two months per symbol. A full rebuild is
# `npm run data:build-r2-rollups -- --full`, run by hand.
ExecStart=/usr/bin/npm run data:build-r2-rollups
TimeoutStartSec=45m
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
