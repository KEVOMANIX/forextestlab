//@version=6
strategy("EMA crossover", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1000)
fast = ta.ema(close, 3)
slow = ta.ema(close, 7)
if ta.crossover(fast, slow)
    strategy.entry("Long", strategy.long)
if ta.crossunder(fast, slow)
    strategy.close("Long")
plot(fast, "Fast EMA")
plot(slow, "Slow EMA")
