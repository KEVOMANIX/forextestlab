{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forextestlab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "r2_buckets": [
    {
      "binding": "MARKET_DATA",
      "bucket_name": "forex-history"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c1e410a868a54ef38fb9f2c3f296b4d4"
    }
  ]
}
