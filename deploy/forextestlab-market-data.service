[Unit]
Description=Refresh ForexTestLab one-minute market data in Cloudflare R2
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/forextestlab
EnvironmentFile=/home/ubuntu/forextestlab/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run data:sync-r2 -- --bootstrap-from=2015-01-01 --overlap-days=2
TimeoutStartSec=24h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
